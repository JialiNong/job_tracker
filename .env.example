# Repo-root .env: read by the pipeline (pnpm pipeline sources / scrape / match)
# and by the Python browser scrapers. The web app reads apps/web/.env.local and
# Prisma reads packages/db/.env (see the .env.example next to each).

# PostgreSQL. Local default: docker compose (pnpm db:up)
DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:54329/tracker_dev

# OpenAI
OPENAI_API_KEY=sk-proj-your_key_here
AI_MODEL=gpt-4.1-mini              # scrape-time title check only
MATCH_THRESHOLD=7.0
MATCH_JOB_MODEL=gpt-5.4-mini       # matcher layer 1 (job labels)
MATCH_COMPANY_MODEL=gpt-5.4-mini   # matcher layer 2 (company lookup, web search)
MATCH_REASONING=low

# Telegram (daily match digest)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ALLOWED_USER_ID=your_user_id
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_MESSAGE_THREAD_ID=your_thread_id

# Optional: Adzuna is opt-in (paid key)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Optional: interpreter for the Python browser scrapers (default python3)
# PYTHON=python3

# --- Legacy Flask + MongoDB stack (kept until Render + Atlas shut down) ---
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
# TRACKER_USERNAME=your_username
# TRACKER_PASSWORD_HASH=
# FLASK_SECRET_KEY=
# AGENT_API_TOKEN=
