# apps/web/.env.local: the Next.js tracker (pnpm --filter @tracker/web dev).
# On Vercel, set the same names in Project Settings -> Environment Variables.

# Local docker Postgres. On Vercel: DATABASE_URL is Neon's pooled string with
# &pgbouncer=true, DIRECT_DATABASE_URL the direct one (docs/deploy.md).
DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:54329/tracker_dev
DIRECT_DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:54329/tracker_dev

# Session cookie encryption, 32+ characters: openssl rand -base64 48
SESSION_SECRET=

# Single-user login. Hash: see docs/setup.md. In this file every $ of the
# bcrypt hash must be written as \$ (Next.js expands $ in .env files).
TRACKER_USERNAME=your_username
TRACKER_PASSWORD_HASH=

# Bearer token for POST /api/agent/jobs (Cursor / Claude daily screens).
# Unset: the agent API answers 503.
AGENT_API_TOKEN=

# Run AI on a single job (local only, not on Vercel)
OPENAI_API_KEY=
# MATCH_THRESHOLD=7.0

# TRACKER_READ_ONLY=1   blocks every write (used during the parallel week)
