# packages/db/.env: Prisma CLI (pnpm db migrate:dev, migrate:deploy).
# Local docker Postgres (pnpm db:up). For Neon use the direct string.
DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:54329/tracker_dev
DIRECT_DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:54329/tracker_dev

# Public demo seed (pnpm db demo:seed) — name must end in _demo:
# DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:54329/tracker_demo
# DIRECT_DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:54329/tracker_demo
